        {
          requirement = "state/ledger";
          resourceId = "owned-state";
        }
      ];
      definition = use(m_definition_studio_message_ledger.definition_studio_message_ledger);
      id = "ledger";
      name = "Reservation ledger";
    }
  ];
  connections = [];
  contract = {
    assumptions = [];
    claims = [
      {
        description = "Declared only; this model experiment checks scenario expectations, not contract claims";
        id = "evidence";
        kind = "required_evidence";
      }
    ];
    id = "stock-ledger";
    revision = "1";
  };
  deploymentPlans = [];
  executionProviders = [
    {
      id = "owned-state";
      kind = "modeled-state";
      version = "1.0.0";
    },
    {
      id = "reservation-broker";
      kind = "modeled-broker";
      version = "1.0.0";
    },
    {
      id = "workflow-model";
      kind = "modeled-workflow";
      version = "1.0.0";
    }
  ];
  id = "m1-unified-reservation";
