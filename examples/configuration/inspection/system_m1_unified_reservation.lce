      definition = use(m_definition_studio_message_stock.definition_studio_message_stock);
      id = "stock";
      messageOwners = [
        {
          componentId = "stock";
          instanceId = "stock";
          slot = "notices";
          stateSlot = "stock";
        },
        {
          componentId = "ledger";
          instanceId = "ledger";
          slot = "notices";
          stateSlot = "ledger";
        }
      ];
      name = "Stock owner";
      workflowMessages = [
        {
          channelComponentId = "stock";
          channelSlot = "notices";
          nodeId = "handoff";
          response = {
            accepted = "accepted";
          };
          routeId = "reservationToLedger";
          slot = "flow";
          sourceNodeId = "reserve";
        }
      ];
      workflowOwners = [
        {
          componentId = "stock";
          ownerId = "stock";
          slot = "flow";
          stateSlot = "stock";
        }
      ];
    },
    {
      artifacts = [];
