            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Review missing or invalid observations";
      };
    },
    {
      branch = {
        else = "observationReview";
        then = "feverGate";
        variable = "gate";
      };
      decision = {
        assign = {
          gate = "valid";
        };
        component = ref(m_behavior_lce_confirm_named_result.behavior_lce_confirm_named_result);
        inputs = {
