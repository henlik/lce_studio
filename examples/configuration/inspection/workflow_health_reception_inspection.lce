language "1.0";
module "export.workflow_health_reception_inspection" version "1.0.0";
import "data_health_reception_values.lce" as m_data_health_reception_values;
import "behavior_health_reception_entry_route.lce" as m_behavior_health_reception_entry_route;
import "behavior_lce_lookup_disposition.lce" as m_behavior_lce_lookup_disposition;
import "behavior_lce_affiliation_disposition.lce" as m_behavior_lce_affiliation_disposition;
import "behavior_lce_review_disposition.lce" as m_behavior_lce_review_disposition;
import "behavior_lce_payment_disposition.lce" as m_behavior_lce_payment_disposition;
import "behavior_lce_candidate_eligible.lce" as m_behavior_lce_candidate_eligible;
import "behavior_lce_confirm_dispatch_choice.lce" as m_behavior_lce_confirm_dispatch_choice;
import "behavior_lce_typed_candidate_eligible.lce" as m_behavior_lce_typed_candidate_eligible;
import "behavior_lce_forward_boolean.lce" as m_behavior_lce_forward_boolean;
import "behavior_lce_confirm_named_result.lce" as m_behavior_lce_confirm_named_result;
import "behavior_lce_begin_interrupt.lce" as m_behavior_lce_begin_interrupt;
import "behavior_lce_confirm_current_handoff.lce" as m_behavior_lce_confirm_current_handoff;
import "behavior_lce_confirm_exception_handoff.lce" as m_behavior_lce_confirm_exception_handoff;
import "state_lce_case_ticket.lce" as m_state_lce_case_ticket;
import "state_lce_case_encounter.lce" as m_state_lce_case_encounter;
import "state_lce_single_slot_assignment.lce" as m_state_lce_single_slot_assignment;

workflow workflow_health_reception_inspection {
  author = "LCE Studio contributors";
  dataContracts = [
    lock(m_data_health_reception_values.data_health_reception_values)
  ];
  decisions = [
    bundle(m_behavior_health_reception_entry_route.behavior_health_reception_entry_route),
    bundle(m_behavior_lce_lookup_disposition.behavior_lce_lookup_disposition),
    bundle(m_behavior_lce_affiliation_disposition.behavior_lce_affiliation_disposition),
    bundle(m_behavior_lce_review_disposition.behavior_lce_review_disposition),
    bundle(m_behavior_lce_payment_disposition.behavior_lce_payment_disposition),
    bundle(m_behavior_lce_candidate_eligible.behavior_lce_candidate_eligible),
    bundle(m_behavior_lce_confirm_dispatch_choice.behavior_lce_confirm_dispatch_choice),
    bundle(m_behavior_lce_typed_candidate_eligible.behavior_lce_typed_candidate_eligible),
    bundle(m_behavior_lce_forward_boolean.behavior_lce_forward_boolean),
    bundle(m_behavior_lce_confirm_named_result.behavior_lce_confirm_named_result),
    bundle(m_behavior_lce_begin_interrupt.behavior_lce_begin_interrupt),
    bundle(m_behavior_lce_confirm_current_handoff.behavior_lce_confirm_current_handoff),
    bundle(m_behavior_lce_confirm_exception_handoff.behavior_lce_confirm_exception_handoff)
  ];
  description = "A synthetic case-level reception workflow: explicit screening, ticket issue/call, identity and affiliation evidence, owned encounter, observations, professional release, payment policy, dispatcher choice, atomic capacity reservation and receiving acceptance. An emergency signal interrupts any active routine task, cancels the case ticket and releases its reservation before awaiting ECU acceptance. Numeric queue sequence is configured per experiment; independent runs do not share a global facility priority queue.";
  entry = "initialScreening";
  id = "health.reception-inspection";
  inputs = [
    {
      name = "caseId";
      type = "string";
    },
    {
      name = "arrivalId";
      type = "string";
    },
    {
      name = "facilityId";
      type = "string";
    },
    {
      name = "serviceId";
      type = "string";
    },
    {
      name = "identifier";
      type = "string";
    },
    {
      name = "capacityA";
      type = "integer";
    },
    {
      name = "capacityB";
      type = "integer";
    },
    {
      name = "queueStart";
      type = "integer";
    }
  ];
  license = "MIT";
  machines = [
    lock(m_state_lce_case_ticket.state_lce_case_ticket),
    lock(m_state_lce_case_encounter.state_lce_case_encounter),
    lock(m_state_lce_single_slot_assignment.state_lce_single_slot_assignment)
  ];
  name = "Reception · staged inspection";
  nodes = [
    {
      id = "initialScreening";
      kind = "task";
      name = "Initial emergency screening";
      next = "entryRoute";
      position = {
        x = 0;
        y = 0;
      };
      stage = "01 Arrival/Screening";
      task = {
        assign = {
          assessmentRecorded = "assessmentRecorded";
          assessmentRef = "assessmentRef";
          emergencyIdentified = "emergencyIdentified";
        };
        instructions = "Record explicit initial screening. This form does not assess or diagnose the patient. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "human";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
        };
        response = [
          {
            name = "assessmentRecorded";
            type = "boolean";
          },
          {
            name = "emergencyIdentified";
            type = "boolean";
          },
          {
            name = "assessmentRef";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Initial emergency screening";
      };
    },
    {
      branch = {
        else = "screeningGate";
        then = "beginEmergency";
        variable = "emergencyIdentified";
      };
      decision = {
        assign = {
          routineAllowed = "routineAllowed";
        };
        component = ref(m_behavior_health_reception_entry_route.behavior_health_reception_entry_route);
        inputs = {
          assessmentRecorded = {
            variable = "assessmentRecorded";
          };
          emergencyIdentified = {
            variable = "emergencyIdentified";
          };
        };
      };
      id = "entryRoute";
      kind = "decision";
      name = "entryRoute";
      position = {
        x = 400;
        y = 0;
      };
      stage = "01 Arrival/Screening";
    },
    {
      branch = {
        else = "initialScreening";
        then = "issueTicket";
        variable = "gate";
      };
      decision = {
        assign = {
          gate = "result";
        };
        component = ref(m_behavior_lce_forward_boolean.behavior_lce_forward_boolean);
        inputs = {
          value = {
            variable = "routineAllowed";
          };
        };
      };
      id = "screeningGate";
      kind = "decision";
      name = "screeningGate";
      position = {
        x = 800;
        y = 0;
      };
      stage = "01 Arrival/Screening";
    },
    {
      branch = {
        else = "dependencyReview";
        then = "callNext";
        variable = "ticketIssued";
      };
      command = {
        acceptedVariable = "ticketIssued";
        assign = {
          ticketId = "ticketId";
          ticketNumber = "ticketNumber";
        };
        command = "issue";
        errorNext = "dependencyReview";
        inputs = {
          caseId = {
            input = "caseId";
          };
        };
        owner = "queue";
      };
      id = "issueTicket";
      kind = "command";
      name = "issueTicket";
      position = {
        x = 1200;
        y = 0;
      };
      stage = "01 Arrival/Queue";
    },
    {
      branch = {
        else = "callNext";
        then = "markCalled";
        variable = "gate";
      };
      id = "callNext";
      kind = "task";
      name = "Call numeric ticket";
      position = {
        x = 0;
        y = 220;
      };
      stage = "01 Arrival/Queue";
      task = {
        assign = {
          gate = "ready";
        };
        instructions = "Call the displayed queue number and explicitly confirm attendance. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "human";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
          ticketNumber = {
            variable = "ticketNumber";
          };
        };
        response = [
          {
            name = "ready";
            type = "boolean";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Call numeric ticket";
      };
    },
    {
      branch = {
        else = "dependencyReview";
        then = "lookupIdentity";
        variable = "gate";
      };
      command = {
        acceptedVariable = "gate";
        assign = {};
        command = "call";
        errorNext = "dependencyReview";
        inputs = {
          caseId = {
            input = "caseId";
          };
        };
        owner = "queue";
      };
      id = "markCalled";
      kind = "command";
      name = "markCalled";
      position = {
        x = 400;
        y = 220;
      };
      stage = "01 Arrival/Queue";
    },
    {
      id = "lookupIdentity";
      kind = "task";
      name = "Query identity registry";
      next = "classifyLookup";
      position = {
        x = 800;
        y = 220;
      };
      stage = "02 Identification";
      task = {
        assign = {
          lookupCompleted = "completed";
          matchCount = "matchCount";
          patientId = "patientId";
        };
        instructions = "Supply completed=false on lookup failure, even when matchCount=0. Only a completed zero-match lookup permits registration. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "adapter";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
          identifier = {
            input = "identifier";
          };
        };
        response = [
          {
            name = "completed";
            type = "boolean";
          },
          {
            name = "matchCount";
            type = "integer";
          },
          {
            name = "patientId";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Query identity registry";
      };
    },
    {
      branch = {
        else = "identityRoute";
        then = "registerPatient";
        variable = "lookupRegister";
      };
      decision = {
        assign = {
          lookupConfirm = "confirm";
          lookupRegister = "register";
        };
        component = ref(m_behavior_lce_lookup_disposition.behavior_lce_lookup_disposition);
        inputs = {
          completed = {
            variable = "lookupCompleted";
          };
          matchCount = {
            variable = "matchCount";
          };
        };
      };
      id = "classifyLookup";
      kind = "decision";
      name = "classifyLookup";
      position = {
        x = 1200;
        y = 220;
      };
      stage = "02 Identification";
    },
    {
      branch = {
        else = "identityReview";
        then = "confirmIdentity";
        variable = "gate";
      };
      decision = {
        assign = {
          gate = "result";
        };
        component = ref(m_behavior_lce_forward_boolean.behavior_lce_forward_boolean);
        inputs = {
          value = {
            variable = "lookupConfirm";
          };
        };
      };
      id = "identityRoute";
      kind = "decision";
      name = "identityRoute";
      position = {
        x = 0;
        y = 440;
      };
      stage = "02 Identification";
    },
    {
      id = "registerPatient";
      kind = "task";
      name = "Register new patient";
      next = "validateIdentity";
      position = {
        x = 400;
        y = 440;
      };
      stage = "02 Identification";
      task = {
        assign = {
          identityConfirmed = "confirmed";
          patientId = "patientId";
        };
        instructions = "Create a named patient only after confirmed zero-match lookup; return confirmed=false on registration failure. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "adapter";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
          lookupCompleted = {
            variable = "lookupCompleted";
          };
          matchCount = {
            variable = "matchCount";
          };
          patientId = {
            variable = "patientId";
          };
        };
        response = [
          {
            name = "confirmed";
            type = "boolean";
          },
          {
            name = "patientId";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Register new patient";
      };
    },
    {
      id = "confirmIdentity";
      kind = "task";
      name = "Confirm existing patient identity";
      next = "validateIdentity";
      position = {
        x = 800;
        y = 440;
      };
      stage = "02 Identification";
      task = {
        assign = {
          identityConfirmed = "confirmed";
          patientId = "patientId";
        };
        instructions = "Explicitly confirm the candidate identity; no demographic merge is automatic. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "human";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
          lookupCompleted = {
            variable = "lookupCompleted";
          };
          matchCount = {
            variable = "matchCount";
          };
          patientId = {
            variable = "patientId";
          };
        };
        response = [
          {
            name = "confirmed";
            type = "boolean";
          },
          {
            name = "patientId";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Confirm existing patient identity";
      };
    },
    {
      id = "identityReview";
      kind = "task";
      name = "Review unresolved identity";
      next = "validateIdentity";
      position = {
        x = 1200;
        y = 440;
      };
      stage = "02 Identification";
      task = {
        assign = {
          identityConfirmed = "confirmed";
          patientId = "patientId";
        };
        instructions = "Resolve unavailable, ambiguous or unconfirmed identity explicitly. confirmed=false remains in review. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "human";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
          lookupCompleted = {
            variable = "lookupCompleted";
          };
          matchCount = {
            variable = "matchCount";
          };
          patientId = {
            variable = "patientId";
          };
        };
        response = [
          {
            name = "confirmed";
            type = "boolean";
          },
          {
            name = "patientId";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Review unresolved identity";
      };
    },
    {
      branch = {
        else = "identityReview";
        then = "lookupAffiliation";
        variable = "gate";
      };
      decision = {
        assign = {
          gate = "valid";
        };
        component = ref(m_behavior_lce_confirm_named_result.behavior_lce_confirm_named_result);
        inputs = {
          confirmed = {
            variable = "identityConfirmed";
          };
          value = {
            variable = "patientId";
          };
        };
      };
      id = "validateIdentity";
      kind = "decision";
      name = "validateIdentity";
      position = {
        x = 0;
        y = 660;
      };
      stage = "02 Identification";
    },
    {
      id = "lookupAffiliation";
      kind = "task";
      name = "Query affiliation evidence";
      next = "classifyAffiliation";
      position = {
        x = 400;
        y = 660;
      };
      stage = "03 Affiliation";
      task = {
        assign = {
          affiliationStatus = "status";
        };
        instructions = "Use verified or confirmedNone only with explicit evidence. unknown, unavailable, expired and contradictory require review. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "adapter";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
          patientId = {
            variable = "patientId";
          };
        };
        response = [
          {
            name = "status";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Query affiliation evidence";
      };
    },
    {
      id = "affiliationReview";
      kind = "task";
      name = "Review unresolved affiliation";
      next = "classifyAffiliation";
      position = {
        x = 800;
        y = 660;
      };
      stage = "03 Affiliation";
      task = {
        assign = {
          affiliationStatus = "status";
        };
        instructions = "Use verified or confirmedNone only with explicit evidence. unknown, unavailable, expired and contradictory require review. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "human";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          facilityId = {
            input = "facilityId";
          };
          patientId = {
            variable = "patientId";
          };
        };
        response = [
          {
            name = "status";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Review unresolved affiliation";
      };
    },
    {
      branch = {
        else = "affiliationReview";
        then = "openEncounter";
        variable = "gate";
      };
      decision = {
        assign = {
          gate = "resolved";
          noAffiliation = "noAffiliation";
        };
        component = ref(m_behavior_lce_affiliation_disposition.behavior_lce_affiliation_disposition);
        inputs = {
          status = {
            variable = "affiliationStatus";
          };
        };
      };
      id = "classifyAffiliation";
      kind = "decision";
      name = "classifyAffiliation";
      position = {
        x = 1200;
        y = 660;
      };
      stage = "03 Affiliation";
    },
    {
      branch = {
        else = "dependencyReview";
        then = "recordVitals";
        variable = "gate";
      };
      command = {
        acceptedVariable = "gate";
        assign = {
          encounterId = "encounterId";
        };
        command = "open";
        errorNext = "dependencyReview";
        inputs = {
          caseId = {
            input = "caseId";
          };
          patientId = {
            variable = "patientId";
          };
        };
        owner = "encounter";
      };
      id = "openEncounter";
      kind = "command";
      name = "openEncounter";
      position = {
        x = 0;
        y = 880;
      };
      stage = "04 Encounter";
    },
    {
      id = "recordVitals";
      kind = "task";
      name = "Record observations and vitals";
      next = "validateObservations";
      position = {
        x = 400;
        y = 880;
      };
      stage = "05 Intake/Observations";
      task = {
        assign = {
          assessmentRef = "assessmentRef";
          feverAlert = "feverAlert";
          observationRef = "observationRef";
          observationsAccepted = "observationsAccepted";
        };
        instructions = "Record whether observations are accepted and supply their reference. Missing observations remain unresolved; feverAlert is an explicit professional observation, not a diagnostic threshold calculated here. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "human";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          encounterId = {
            variable = "encounterId";
          };
          facilityId = {
            input = "facilityId";
          };
        };
        response = [
          {
            name = "observationsAccepted";
            type = "boolean";
          },
          {
            name = "feverAlert";
            type = "boolean";
          },
          {
            name = "observationRef";
            type = "string";
          },
          {
            name = "assessmentRef";
            type = "string";
          },
          {
            name = "actorRef";
            type = "string";
          },
          {
            name = "evidenceRef";
            type = "string";
          }
        ];
        title = "Record observations and vitals";
      };
    },
    {
      id = "observationReview";
      kind = "task";
      name = "Review missing or invalid observations";
      next = "validateObservations";
      position = {
        x = 800;
        y = 880;
      };
      stage = "05 Intake/Observations";
      task = {
        assign = {
          assessmentRef = "assessmentRef";
          feverAlert = "feverAlert";
          observationRef = "observationRef";
          observationsAccepted = "observationsAccepted";
        };
        instructions = "Record whether observations are accepted and supply their reference. Missing observations remain unresolved; feverAlert is an explicit professional observation, not a diagnostic threshold calculated here. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
        kind = "human";
        request = {
          arrivalId = {
            input = "arrivalId";
          };
          caseId = {
            input = "caseId";
          };
          encounterId = {
            variable = "encounterId";
          };
          facilityId = {
            input = "facilityId";
          };
