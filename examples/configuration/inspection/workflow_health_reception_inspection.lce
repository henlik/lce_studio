      id = "validateObservations";
      kind = "decision";
      name = "validateObservations";
      position = {
        x = 1200;
        y = 880;
      };
      stage = "05 Intake/Observations";
    },
    {
      branch = {
        else = "clinicalReview";
        then = "feverReview";
        variable = "gate";
      };
      decision = {
        assign = {
          gate = "result";
        };
        component = ref(m_behavior_lce_forward_boolean.behavior_lce_forward_boolean);
        inputs = {
          value = {
            variable = "feverAlert";
          };
        };
      };
      id = "feverGate";
      kind = "decision";
      name = "feverGate";
      position = {
        x = 0;
        y = 1100;
      };
      stage = "05 Intake/Observations";
    },
    {
      id = "feverReview";
      kind = "task";
      name = "Clinician fever assessment and release";
      next = "classifyClinical";
      position = {
        x = 400;
        y = 1100;
      };
      stage = "05 Intake/Clinical release";
      task = {
        assign = {
          clinicalAuthorized = "authorized";
          clinicalDisposition = "disposition";
          reviewAssessmentRef = "assessmentRef";
        };
        instructions = "A professional explicitly supplies released, review or emergency. Release must be authorized and tied to the current assessment reference; no automatic clinical clearance is inferred. Responses are explicit synthetic fixtures; actorRef and evidenceRef record their supplied provenance. No live integration is performed.";
