        {
          id = string("resource-2");
          scope = string("student:read");
          tenantId = string("tenant-beta");
        }
      ];
      Subjects = [
        {
          active = boolean(true);
          id = string("subject-1");
          role = string("teacher");
          tenantId = string("tenant-alpha");
        },
        {
          active = boolean(false);
          id = string("subject-2");
          role = string("teacher");
          tenantId = string("tenant-beta");
        }
      ];
    };
  };
  target = target(m_data_lce_organization_registry.data_lce_organization_registry);
