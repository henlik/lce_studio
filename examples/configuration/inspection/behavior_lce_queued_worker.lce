language "1.0";
module "export.behavior_lce_queued_worker" version "1.0.0";


behavior behavior_lce_queued_worker {
  author = "LCE Studio contributors";
  capabilities = [
    "design",
    "simulate"
  ];
  config = {
    capacity = {
      default = 2;
      max = 100;
      min = 1;
    };
    deduplicate = false;
    memoryMb = {
      default = 128;
      max = 8192;
      min = 16;
    };
    processingMs = {
      default = 20;
      max = 60000;
      min = 0;
    };
  };
  description = "A bounded FIFO processing stage with configurable concurrency and resident memory.";
  id = "lce.queued-worker";
  kernel = "service";
  license = "MIT";
  name = "Queued worker";
  schemaVersion = 1;
  version = "1.0.0";
}
