language "1.0";
module "export.behavior_lce_reserve_available" version "1.0.0";
import "data_lce_reservation_data.lce" as m_data_lce_reservation_data;

behavior behavior_lce_reserve_available {
  author = "LCE Studio contributors";
  behavior = {
    bindings = {
      accepted = {
        node = "accepted";
        port = "result";
      };
      acceptedSinceRestart = {
        node = "nextCounter";
        port = "result";
      };
      notice = {
        node = "notice";
        port = "result";
      };
      reason = {
        node = "reason";
        port = "result";
      };
