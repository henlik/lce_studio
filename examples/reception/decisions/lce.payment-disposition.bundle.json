            {
              "id": "proceed",
              "op": "or",
              "inputs": {
                "left": {
                  "node": "allow",
                  "port": "result"
                },
                "right": {
                  "node": "alternatives",
                  "port": "result"
                }
              },
              "position": {
                "x": 0,
                "y": 200
              }
            },
            {
              "id": "route",
              "op": "select",
              "inputs": {
                "condition": {
                  "node": "proceed",
                  "port": "result"
                },
                "falseValue": {
                  "literal": {
                    "type": "string",
                    "string": "review"
                  }
                },
                "trueValue": {
                  "literal": {
                    "type": "string",
                    "string": "proceed"
                  }
                }
              },
              "position": {
                "x": 360,
                "y": 200
              }
