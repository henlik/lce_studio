      "package": {
        "schemaVersion": 2,
        "id": "lce.payment-disposition",
        "version": "1.0.0",
        "name": "Interpret explicit payment policy",
        "description": "Consumes an explicit policy disposition. Allow, defer and waive permit routine continuation; review, error and unknown values require review. It does not charge money, infer coverage or block emergency routing.",
        "author": "LCE Studio contributors",
        "license": "MIT",
        "kernel": "composite",
        "capabilities": [
          "design",
          "evaluate"
        ],
        "config": {
          "processingMs": {
            "default": 0,
            "min": 0,
            "max": 0
          },
          "capacity": {
            "default": 0,
            "min": 0,
            "max": 0
          },
          "memoryMb": {
            "default": 0,
            "min": 0,
            "max": 0
          },
          "deduplicate": false
        },
        "behavior": {
          "inputs": [
            {
              "name": "disposition",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "name": "route",
              "type": "string"
            },
            {
              "name": "proceed",
              "type": "boolean"
            }
          ],
          "nodes": [
            {
              "id": "allow",
              "op": "equal",
              "inputs": {
                "left": {
                  "input": "disposition"
                },
                "right": {
                  "literal": {
                    "type": "string",
                    "string": "allow"
                  }
                }
              },
              "position": {
                "x": 0,
                "y": 0
              }
            },
            {
              "id": "defer",
              "op": "equal",
              "inputs": {
                "left": {
                  "input": "disposition"
                },
                "right": {
                  "literal": {
                    "type": "string",
                    "string": "defer"
                  }
                }
              },
              "position": {
                "x": 360,
                "y": 0
              }
            },
            {
              "id": "waive",
              "op": "equal",
              "inputs": {
                "left": {
                  "input": "disposition"
                },
                "right": {
                  "literal": {
                    "type": "string",
                    "string": "waive"
                  }
                }
              },
              "position": {
                "x": 720,
                "y": 0
              }
            },
            {
              "id": "alternatives",
              "op": "or",
              "inputs": {
                "left": {
                  "node": "defer",
