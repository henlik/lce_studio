                }
              },
              "position": {
                "x": 720,
                "y": 200
              }
            },
            {
              "id": "patientNamedEmpty",
              "op": "equal",
              "inputs": {
                "left": {
                  "input": "patientId"
                },
                "right": {
                  "literal": {
                    "type": "string",
                    "string": ""
                  }
                }
              },
              "position": {
                "x": 1080,
                "y": 200
              }
            },
            {
              "id": "patientNamed",
              "op": "not",
