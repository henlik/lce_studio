              },
              "position": {
                "x": 1080,
                "y": 0
              }
            },
            {
              "id": "ownerAllowed",
              "op": "or",
              "inputs": {
                "left": {
                  "node": "unopened",
                  "port": "result"
                },
                "right": {
                  "node": "sameVisit",
                  "port": "result"
                }
              },
              "position": {
                "x": 0,
                "y": 200
              }
            },
            {
              "id": "caseNamedEmpty",
              "op": "equal",
              "inputs": {
                "left": {
                  "input": "caseId"
                },
                "right": {
