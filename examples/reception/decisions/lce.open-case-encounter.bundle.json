              "op": "equal",
              "inputs": {
                "left": {
                  "input": "currentCase"
                },
                "right": {
                  "literal": {
                    "type": "string",
                    "string": ""
                  }
                }
              },
              "position": {
                "x": 0,
                "y": 0
              }
            },
            {
              "id": "sameCase",
              "op": "equal",
              "inputs": {
                "left": {
                  "input": "currentCase"
                },
                "right": {
                  "input": "caseId"
                }
              },
              "position": {
                "x": 360,
                "y": 0
