      "package": {
        "schemaVersion": 2,
        "id": "lce.same-tenant",
        "version": "1.0.0",
        "name": "Same tenant",
        "description": "Compares two explicit tenant identifiers as exact strings; it does not authenticate either identity.",
        "author": "LCE Studio contributors",
        "license": "MIT",
        "kernel": "composite",
        "capabilities": [
          "design",
          "evaluate"
        ],
        "config": {
          "processingMs": {
            "default": 0,
            "min": 0,
            "max": 0
          },
          "capacity": {
            "default": 0,
            "min": 0,
            "max": 0
          },
          "memoryMb": {
            "default": 0,
            "min": 0,
            "max": 0
          },
          "deduplicate": false
        },
        "behavior": {
          "inputs": [
            {
              "name": "subjectTenant",
              "type": "string"
            },
            {
              "name": "resourceTenant",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "name": "sameTenant",
              "type": "boolean"
            }
          ],
          "nodes": [
            {
              "id": "compare",
              "op": "equal",
              "inputs": {
                "left": {
                  "input": "subjectTenant"
                },
                "right": {
                  "input": "resourceTenant"
                }
              },
              "position": {
                "x": 240,
                "y": 120
              }
            }
          ],
          "bindings": {
            "sameTenant": {
              "node": "compare",
              "port": "result"
            }
          }
        },
