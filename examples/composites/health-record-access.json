            "name": "Same tenant",
            "inputs": {
              "resourceTenant": {
                "type": "string",
                "string": "tenant-alpha"
              },
              "subjectTenant": {
                "type": "string",
                "string": "tenant-alpha"
              }
            },
            "expected": {
              "sameTenant": {
                "type": "boolean",
                "boolean": true
              }
            }
          },
